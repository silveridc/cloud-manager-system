{
  "name": "zhaoyj/cloud-manager-system",
  "description": "Cloud Manager System",
  "type": "project",
  "keywords": [
    "hosting",
    "billing",
    "thinkphp"
  ],
  "license": "proprietary",
  "require": {
    "php": ">=8.1.0",
    "topthink/framework": "^8.0",
    "topthink/think-orm": "^4.0",
    "topthink/think-filesystem": "^3.0",
    "topthink/think-multi-app": "^1.1",
    "topthink/think-view": "^2.0",
    "topthink/think-template": "^3.0",
    "firebase/php-jwt": "^7.1",
    "sentry/sentry": "^4.28",
    "ext-curl": "*"
  },
  "require-dev": {
    "topthink/think-dumper": "^1.0",
    "topthink/think-trace": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "app\\": "app",
      "addon\\": "plugins/addon/",
      "gateway\\": "plugins/gateway/",
      "server\\": "plugins/server/",
      "reserver\\": "plugins/reserver/",
      "sms\\": "plugins/sms/",
      "mail\\": "plugins/mail/",
      "captcha\\": "plugins/captcha/",
      "certification\\": "plugins/certification/",
      "oauth\\": "plugins/oauth/",
      "oss\\": "plugins/oss/",
      "invoice\\": "plugins/invoice/"
    },
    "psr-0": {
      "": "extend/"
    }
  },
  "config": {
    "preferred-install": "dist"
  },
  "scripts": {
    "post-autoload-dump": [
      "@php think service:discover",
      "@php think vendor:publish"
    ]
  }
}
